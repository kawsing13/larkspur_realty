# Copy to .env.production and fill in. Keep it out of version control (it is git-ignored).
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- Postgres (the db service) ----
POSTGRES_USER=rems
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=rems

# ---- Server (the server service, via env_file) ----
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# The public origin of the web app. CORS allows only this.
CLIENT_ORIGIN=https://your-domain.example

# `web` and `server` are on the same Docker network; "db" and "storage" are hostnames.
DATABASE_URL=postgresql://rems:CHANGE-ME-strong-password@db:5432/rems?schema=public

JWT_ACCESS_SECRET=CHANGE-ME-64-hex-chars
JWT_REFRESH_SECRET=CHANGE-ME-different-64-hex-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# How many proxies sit in front (nginx = 1; add 1 per extra proxy / load balancer).
TRUST_PROXY=2
# "lax" if the web app and API share a registrable domain; "none" if fully cross-domain.
COOKIE_SAMESITE=lax
# Serve Swagger UI in production? Default is off.
ENABLE_API_DOCS=false

# ---- Object storage (the storage service) ----
# "minio" for the bundled container; "s3" for a managed S3/R2 (drop the storage service).
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://storage:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=rems
STORAGE_SECRET_KEY=CHANGE-ME-strong-password
STORAGE_BUCKET=rems-media
STORAGE_DOCS_BUCKET=rems-docs
# The public base URL for media (a CDN or the storage host reachable by browsers).
STORAGE_PUBLIC_URL=https://media.your-domain.example

# ---- Maps (optional) ----
MAPBOX_TOKEN=

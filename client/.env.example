# Copy to client/.env. Vite only exposes variables prefixed with VITE_.

# API base path. In dev, keep "/api" and let Vite proxy it to the Express server.
VITE_API_BASE_URL=/api

# Optional Mapbox token for the interactive map on the listing page (Phase 3).
# Leave blank to show a plain address block instead.
VITE_MAPBOX_TOKEN=

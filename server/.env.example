# Copy this file to server/.env and adjust as needed.
# .env is git-ignored. Never commit real secrets.

# ---- Server ----------------------------------------------------
NODE_ENV=development
PORT=4000

# The browser app origin. CORS allows only this origin (with credentials).
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ------------------------------------------------
# Matches docker-compose.yml. Change only if you run your own Postgres.
DATABASE_URL=postgresql://rems:rems_dev_pw@localhost:5432/rems?schema=public

# ---- Auth ---------------------------------------------------
# For anything but local dev, generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-please-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-please-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- Object storage (MinIO / S3) -------------------------
# Property images are uploaded here from Phase 2. The bucket is made public-read
# on startup so the public site can show the photos directly.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=rems
STORAGE_SECRET_KEY=rems_dev_pw
STORAGE_BUCKET=rems-media
# Private bucket for property documents. Never made public; downloads go through
# an access-checked route.
STORAGE_DOCS_BUCKET=rems-docs
# Base URL browsers use to load public media. In prod, point this at a CDN or domain.
STORAGE_PUBLIC_URL=http://localhost:9000

# ---- Maps (optional) --------------------------------------
# Leave blank to show a plain address block instead of an interactive map.
MAPBOX_TOKEN=
